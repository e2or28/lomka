config_version=5

[application]

config/name="Ломка"
config/description="Кооперативный рогалик с видом сверху. Закрытый рукотворный мир, случайное наполнение, органы вместо валюты."
run/main_scene="res://game/dev_sandbox.tscn"
config/features=PackedStringArray("4.7")


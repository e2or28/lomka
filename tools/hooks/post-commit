#!/usr/bin/env bash
# Пересобрать дашборд по строкам кода после коммита.
#
# Именно post-commit, а не pre-commit: коммит не должен ждать статистику.
# Здесь хук уже ничего не решает — он просто обновляет картинку на рабочем
# столе, и даже упав, коммиту не мешает.
#
# С тёплым кешем это меньше десятой доли секунды: прошлые коммиты не
# пересчитываются, только новый.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

python3 tools/code_stats.py >/dev/null 2>&1 || true
exit 0

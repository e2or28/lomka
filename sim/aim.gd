extends RefCounted
## Прицел: четыре направления и ничего между ними.
##
## Свободный угол убран решением от 2 сентября 2026 (docs/DECISIONS.md), и
## это правило игры, а не представления: по нему летят снаряды, встаёт
## укрытие и целится автобот. Поэтому оно живёт в симуляции, а вид, ввод и
## инструменты спрашивают его здесь, а не считают заново каждый свой раз.

## Оси возвращаются точными, а не поворотом на угол: повёрнутый вектор даёт
## −4,4e-08 вместо нуля, и этот мусор уезжает в сейв, в хеш состояния и в
## сравнения вида «направление вдоль x». Сколько направлений — видно здесь
## и больше нигде; тест ввода сторожит, что их ровно четыре.
static func snap(vector: Vector2) -> Vector2:
	if vector == Vector2.ZERO:
		return vector
	# Ровная диагональ уходит в вертикаль: так вело себя округление по углу,
	# на котором стоял ввод, и менять это заодно с переездом незачем.
	if absf(vector.x) > absf(vector.y):
		return Vector2.LEFT if vector.x < 0.0 else Vector2.RIGHT
	return Vector2.UP if vector.y < 0.0 else Vector2.DOWN
